#!/usr/bin/env python3
"""Run a command on a real pseudo-terminal and type answers into its prompts.

    pty "<answers>" <command> [args...]

Each character of <answers> is typed, one at a time, whenever the program has
gone quiet; "\\n" in <answers> presses Enter. The combined
terminal output is printed and the command's exit status is returned.

This is how the suite tests behaviour that only exists on a terminal: colours
and prompts that really wait for a key, without a stubbed "is a terminal" check.
"""
import os
import pty
import select
import sys
import time

answers = list(sys.argv[1].replace("\\n", "\n"))
command = sys.argv[2:]

pid, master = pty.fork()
if pid == 0:
    os.execvp(command[0], command)

output = b""
deadline = time.time() + 60
status = 1
while True:
    if time.time() > deadline:
        os.kill(pid, 9)
        sys.stdout.write(output.decode(errors="replace"))
        sys.stdout.write("\n[pty] timed out waiting for the command\n")
        sys.exit(124)
    ready, _, _ = select.select([master], [], [], 0.2)
    if master in ready:
        try:
            chunk = os.read(master, 65536)
        except OSError:
            chunk = b""
        if not chunk:
            break
        output += chunk
        continue
    # Quiet for a moment: type the next key. Keys typed before the program
    # asks simply wait in the terminal's input queue, in order.
    if answers and output:
        os.write(master, answers.pop(0).encode())

_, wait_status = os.waitpid(pid, 0)
if os.WIFEXITED(wait_status):
    status = os.WEXITSTATUS(wait_status)
sys.stdout.write(output.decode(errors="replace").replace("\r\n", "\n"))
sys.exit(status)
